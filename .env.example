# Скопируйте этот файл в .env и заполните под себя.
# .env в Git НЕ попадает (см. .gitignore). Здесь только плейсхолдеры-примеры.

# Город поиска (например: Алматы)
CITY=
# Категория бизнеса (например: стоматология)
CATEGORY=
# Сколько компаний собрать
COUNT=30

# --- Рассылка (outreach) ---
# Ваше имя — подставляется в сообщение-открывашку («Меня зовут …»)
SENDER_NAME=
# Ваш контакт (телефон / Instagram) — подпись в конце аудита
SENDER_CONTACT=

# --- Мониторинг (веб-панель app.py, опционально) ---
# Токен Telegram-бота (можно задать и в самой панели, в «Настройках»)
TELEGRAM_BOT_TOKEN=
# Порт веб-панели (по умолчанию 8765)
PORT=

# --- Деплой на VPS (этап 4 ROADMAP) ---
# Пароль для входа в панель. Пусто = панель открыта (только для локали!).
# В интернете задавать ОБЯЗАТЕЛЬНО.
PANEL_PASSWORD=
# Разрешённые домены через запятую (Host-allowlist). На VPS — ваш домен.
PANEL_HOSTS=
# Адрес прослушивания: 127.0.0.1 локально, 0.0.0.0 в Docker за Caddy.
PANEL_BIND=
# Ключ подписи сессий (64 hex). Пусто = сгенерируется и сохранится в БД.
PANEL_SECRET=

# --- AI-ответы на отзывы (этап 1 ROADMAP) ---
# Ключ OpenAI API (можно задать и в панели, в «Настройках»)
OPENAI_API_KEY=
# Модель (по умолчанию gpt-5.4-mini)
OPENAI_MODEL=gpt-5.4-mini

# --- Технические настройки (опционально) ---
# Прокси для запросов к 2GIS. Пусто = ходим со своего IP (обычный режим).
# Понадобится, только если 2GIS начнёт банить по IP.
# Формат: http://user:pass@host:port или socks5://host:port
SCRAPE_PROXY=
# headless-браузер: true/false
HEADLESS=true
# Папка для CSV-результатов
OUTPUT_DIR=output
