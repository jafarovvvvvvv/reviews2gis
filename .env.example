# Скопируйте этот файл в .env и заполните под себя.
# .env в Git НЕ попадает (см. .gitignore). Здесь только плейсхолдеры-примеры.

# Город поиска (например: Алматы)
CITY=
# Категория бизнеса (например: стоматология)
CATEGORY=
# Сколько компаний собрать
COUNT=30

# --- Рассылка (outreach) ---
# В веб-панели те же поля есть в «Настройках» → «Подпись в письмах лидам»
# (значения из панели имеют приоритет).
# Ваше имя — подставляется в сообщение-открывашку («Меня зовут …»)
SENDER_NAME=
# Ваш контакт (телефон / Instagram) — подпись в конце аудита
SENDER_CONTACT=

# --- Мониторинг (веб-панель app.py, опционально) ---
# Токен Telegram-бота (можно задать и в самой панели, в «Настройках»)
TELEGRAM_BOT_TOKEN=
# Порт веб-панели (по умолчанию 8765)
PORT=

# --- Деплой на VPS (этап 4 ROADMAP) ---
# Пароль для входа в панель. Пусто = панель открыта (только для локали!).
# В интернете задавать ОБЯЗАТЕЛЬНО.
PANEL_PASSWORD=
# Разрешённые домены через запятую (Host-allowlist). На VPS — ваш домен.
PANEL_HOSTS=
# Адрес прослушивания: 127.0.0.1 локально, 0.0.0.0 в Docker за Caddy.
PANEL_BIND=
# Ключ подписи сессий (64 hex). Пусто = сгенерируется и сохранится в БД.
PANEL_SECRET=

# --- AI-ответы на отзывы (этап 1 ROADMAP) ---
# Ключ OpenAI API (можно задать и в панели, в «Настройках»)
OPENAI_API_KEY=
# Модель (по умолчанию gpt-5.4-mini)
OPENAI_MODEL=gpt-5.4-mini

# --- Мост с CRM Bedel (см. CRM_INTEGRATION.md) ---
# Общий секрет: то же значение должно быть в .env CRM Bedel (REVIEWS2GIS_API_KEY).
# Пусто = мост выключен целиком (GET /api/firm/{id} отдаёт 404).
BRIDGE_API_KEY=
# Куда пушить найденных лидов после прогона leadgen.py. Пусто = не пушить,
# лиды остаются только в output/*.csv, как раньше.
# Локально: http://127.0.0.1:8000/leads/push · на сервере: http://host.docker.internal:8000/leads/push
CRM_PUSH_URL=

# --- Технические настройки (опционально) ---
# Прокси для запросов к 2GIS. Пусто = ходим со своего IP (обычный режим).
# Понадобится, только если 2GIS начнёт банить по IP.
# Формат: http://user:pass@host:port или socks5://host:port
SCRAPE_PROXY=
# --- Разбор (аудит) ---
# Окно выборки отзывов для ВСЕХ счётчиков («без ответа», негатив, свежие).
# Печатается рядом с числами в документе, чтобы их нельзя было прочитать
# как «из всех отзывов компании».
REVIEW_WINDOW=50
# Данные старше этого срока (часы) считаются несвежими: перед рендером разбора
# компания перечитывается с 2ГИС. Не удалось — разбор не строится вовсе.
AUDIT_MAX_AGE_HOURS=24
# Блок «сравнение с конкурентом» в разборе: 0 — выключен (по умолчанию), 1 — включён.
AUDIT_COMPETITOR=0
# Черновики ответов под первыми 2 цитатами негатива без ответа: 1 — включены
# (по умолчанию), 0 — выключены. Готовый ответ под цитатой — то, ради чего
# разбор и отправляется директору, поэтому по умолчанию включено. Нужен рабочий
# OPENAI_API_KEY выше — без ключа разбор строится без черновиков даже при 1.
# На больших прогонах лидогенерации ставьте 0: это до 2 запросов к OpenAI
# на каждую карточку пакета.
DRAFT_REPLIES=1

# Способ чтения для CLI: auto (HTTP, браузер в резерве) | http | browser.
# В панели то же выбирается в «Настройках» → «Способ чтения карточек».
FETCH_MODE=auto
# headless-браузер: true/false
HEADLESS=true
# Папка для CSV-результатов
OUTPUT_DIR=output
